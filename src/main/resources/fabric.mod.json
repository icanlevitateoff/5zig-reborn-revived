    "5zig",
    "RoccoDev",
    "zortax",
    "IcanLevitate"
  ],
  "contact": {
    "sources": "https://github.com/5zig-reborn/The-5zig-Mod"
  },
  "license": "GPL-3.0-or-later",
  "icon": "images/5zig-icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "io.icanlevitateoff.fivezigrebornrevived.fabric.FiveZigClient"
    ]
  },
  "mixins": [
    "fivezigrebornrevived.mixins.json"
  ],
  "depends": {
